# ============================================================================
# Íris — Plataforma Inteligente de Adaptação de Materiais Pedagógicos
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# Copie para .env: cp .env.example .env
# ============================================================================

# --- 1. Ambiente da Aplicação (FastAPI Stateless / Zero-Database) ---
IRIS_ENV=development
IRIS_HOST=127.0.0.1
IRIS_PORT=8000
IRIS_LOG_LEVEL=INFO

# --- 2. Configuração da Camada de LLM (Local Ollama vs. API Externa) ---
# Opções de provedor: "ollama" (local sem custo/LGPD) ou "groq" (API rápida em nuvem)
IRIS_LLM_PROVIDER=ollama
RAG_LLM=ollama

# Modelo padrão quando IRIS_LLM_PROVIDER=ollama (ex.: llama3.1:8b ou qwen2.5:7b ou qwen3:8b)
IRIS_LLM_MODEL=llama3.1:8b
RAG_LLM_MODELO=llama3.1:8b
OLLAMA_URL=http://127.0.0.1:11434

# Chave de API quando IRIS_LLM_PROVIDER=groq (ex.: modelo llama-3.3-70b-versatile ou qwen/qwen3.8-27b)
GROQ_API_KEY=

# --- 3. Configuração do Módulo RAG (Base de Conhecimento Científica) ---
# Banco vetorial: "pgvector" (PostgreSQL via Docker) ou "bm25" (em memória sem banco)
RAG_BANCO=pgvector

# Método de recuperação padrão: "qwen3+rerank50", "hibrido+rerank", "qwen3", "mpnet" ou "bm25"
RAG_METODO=qwen3+rerank50

# Cross-encoder de reordenação: "mminilm" (padrão rápido) ou "bge-m3"
RAG_RERANKER=mminilm

# Conexão com o PostgreSQL + pgvector (apenas base científica pública; ZERO dados de alunos)
RAG_PG_DSN=postgresql://iris:iris@127.0.0.1:5433/iris

# --- 4. Juiz de Auditoria RAG / RAGAS (Claude Sonnet via API) ---
# Cole sua chave da Anthropic abaixo para avaliar a Fidelidade (Regra v2 + prova literal)
# nas 136 questões escolares e no modo Ao Vivo com Llama 3.
ANTHROPIC_API_KEY=
IRIS_JUDGE_MODEL=claude-sonnet-4-20250514


