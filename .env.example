# ============================================================================
# Íris — Plataforma Inteligente de Adaptação de Materiais Pedagógicos
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# Copie para .env: cp .env.example .env
# ============================================================================

# --- 1. Ambiente da Aplicação (FastAPI Stateless / Zero-Database) ---
IRIS_ENV=development
IRIS_HOST=127.0.0.1
IRIS_PORT=8000
IRIS_LOG_LEVEL=INFO

# --- 2. Configuração da Camada de LLM (Local Ollama vs. API Externa) ---
# Opções de provedor: "ollama" (local sem custo/LGPD) ou "groq" (API rápida em nuvem)
IRIS_LLM_PROVIDER=ollama
RAG_LLM=ollama

# Modelo padrão quando IRIS_LLM_PROVIDER=ollama (ex.: llama3.1:8b ou qwen2.5:7b ou qwen3:8b)
IRIS_LLM_MODEL=llama3.1:8b
RAG_LLM_MODELO=llama3.1:8b
OLLAMA_URL=http://127.0.0.1:11434
# Piso da janela de contexto enviada ao Ollama (tokens). O cliente sobe sozinho quando o prompt não cabe.
# OLLAMA_NUM_CTX=8192

# Chave de API quando IRIS_LLM_PROVIDER=groq (ex.: modelo llama-3.3-70b-versatile ou qwen/qwen3.8-27b)
GROQ_API_KEY=

# Habilita envio dos agentes de adaptação/auditoria para API externa (LGPD Art. 14 / ADR-11 / #106).
# Padrão: false (Privacy by Default). Mesmo com ANTHROPIC_API_KEY configurada para o Juiz RAG,
# Adaptador e Auditor permanecem locais até a escola ativar explicitamente esta flag.
IRIS_ALLOW_EXTERNAL_ADAPTATION_LLM=false
# Overrides opcionais por agente (ex.: manter Adaptador local mesmo com a flag ativa):
# IRIS_LLM_PROVIDER_ADAPTADOR=ollama
# IRIS_LLM_PROVIDER_AUDITOR=ollama

# --- 3. Configuração do Módulo RAG (Base de Conhecimento Científica) ---
# Banco vetorial: "pgvector" (PostgreSQL via Docker) ou "bm25" (em memória sem banco)
RAG_BANCO=pgvector

# Método de recuperação padrão: "qwen3+rerank50", "hibrido+rerank", "qwen3", "mpnet" ou "bm25"
RAG_METODO=qwen3+rerank50

# Cross-encoder de reordenação: "mminilm" (padrão rápido) ou "bge-m3"
RAG_RERANKER=mminilm

# Gate determinístico de recusa antes do LLM (desligado por padrão; calibrado em reports/rag_calibracao_recusa.txt)
# RAG_RERANK_MIN_SCORE=0.7281

# Conexão com o PostgreSQL + pgvector (apenas base científica pública; ZERO dados de alunos)
RAG_PG_DSN=postgresql://iris:iris@127.0.0.1:5433/iris

# --- 4. Juiz de Auditoria RAG / RAGAS (Claude Sonnet via API) ---
# Cole sua chave da Anthropic abaixo para avaliar a Fidelidade (Regra v2 + prova literal)
# nas 136 questões escolares e no modo Ao Vivo com Llama 3.
ANTHROPIC_API_KEY=
IRIS_JUDGE_MODEL=claude-sonnet-5-5
# Modelo que escreve as respostas no Benchmark Escolar. Vazio: o padrão do gerador (rag/iris-rag/pacote/gerar.py).
IRIS_GENERATOR_MODEL=

# --- 5. Autenticação Docente & Histórico Sanitizado (ADR-10 / Opcional) ---
IRIS_APP_PG_DSN=postgresql://iris:iris@127.0.0.1:5433/iris
IRIS_JWT_SECRET=
IRIS_JWT_ACCESS_TTL_MINUTES=30
IRIS_JWT_REFRESH_TTL_DAYS=14
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/google/callback
IRIS_FRONTEND_URL=http://localhost:3000


